# Motor de IA:
#   auto        -> usa Claude Code (tu suscripción) si está instalado y con sesión; si no, API key; si no, simulado
#   claude-code -> sólo Claude Code CLI (suscripción Pro/Max). Requiere haber ejecutado `claude` e iniciado sesión.
#   api         -> sólo API de Anthropic (ANTHROPIC_API_KEY)
#   mock        -> modo simulado, sin IA
LLM_PROVIDER=claude-code

# Token de Claude Code (opcional). Generalo con `claude setup-token` y pegalo acá.
# Lo usa sólo el comando oficial `claude`; la app no lo lee ni lo envía a ningún lado.
# No compartas este archivo (.env) ni lo incluyas si mandás el proyecto a alguien.
CLAUDE_CODE_OAUTH_TOKEN=

# Modelo para Claude Code (alias: sonnet, opus, haiku)
CLAUDE_CODE_MODEL=sonnet

# Sólo si usás la API (opcional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Puerto local (opcional)
PORT=3000
